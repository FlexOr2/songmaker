[Unit]
Description=Watch the agent CLI logins for a refresh (issue #350)

[Path]
# The paths below are placeholders (this repo's canonical operator), kept
# concrete only so `systemd-analyze verify` can check absolute paths.
# scripts/install-cli-credentials-mirror.sh rewrites every one of them with
# the installing user's real home at install time.
#
# PathChanged and PathModified are both listed for each file on purpose: the
# CLIs replace their credential file by renaming a temporary file over it,
# and an in-place rewrite by some future version must trigger the mirror just
# as reliably. Re-running the mirror is idempotent, so a doubled trigger
# costs nothing and a missed one costs the co-writer.
PathChanged=/home/felix-hummert/.claude/.credentials.json
PathModified=/home/felix-hummert/.claude/.credentials.json
PathChanged=/home/felix-hummert/.grok/auth.json
PathModified=/home/felix-hummert/.grok/auth.json
PathChanged=/home/felix-hummert/.codex/auth.json
PathModified=/home/felix-hummert/.codex/auth.json
Unit=songmaker-cli-credentials-mirror.service

[Install]
WantedBy=paths.target

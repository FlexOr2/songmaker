# Derived from Docker Engine 29.1.3's docker-default profile generated by
# github.com/moby/profiles/apparmor (ABI 3.0). It retains that profile's
# denials and adds only the user namespace and mount operations Bubblewrap
# 0.9.0 needs for the Codex read-only sandbox.
abi <abi/3.0>,
#include <tunables/global>

profile "songmaker-web" flags=(attach_disconnected,mediate_deleted) {
  #include <abstractions/base>

  network,
  deny network alg,
  deny network vsock,
  capability,
  file,
  umount,
  userns,
  signal (receive) peer=unconfined,
  signal (receive) peer=runc,
  signal (receive) peer=crun,
  signal (send,receive) peer=songmaker-web,

  deny @{PROC}/* w,
  deny @{PROC}/{[^1-9/],[^1-9/][^0-9/],[^1-9s/][^0-9y/][^0-9s/],[^1-9/][^0-9/][^0-9/][^0-9/]*}/** w,
  deny @{PROC}/sys/[^k]** w,
  deny @{PROC}/sys/kernel/{?,??,[^s][^h][^m]**} w,
  deny @{PROC}/sysrq-trigger rwklx,
  deny @{PROC}/kcore rwklx,

  # Bubblewrap first makes the copied mount tree a recursive slave so its
  # later mounts cannot propagate back to the web container.
  mount options=(rslave) -> /,
  # Its temporary construction root is a nodev,nosuid tmpfs at /tmp.
  mount fstype=tmpfs options=(rw nosuid nodev) none -> /tmp/,
  # Bubblewrap bind-mounts that construction root before the first pivot_root.
  mount options=(rw rbind) /tmp/newroot/ -> /tmp/newroot/,
  # It detaches the old root after each pivot and makes it private first.
  mount options=(rprivate) -> /oldroot/,

  # --ro-bind / / recursively binds only the old root into the new root, then
  # remounts every resulting mount nodev,nosuid,read-only.
  mount options=(rw rbind) /oldroot/ -> /newroot/,
  mount options=(ro remount bind nosuid nodev) -> /newroot/{,**},
  # --proc mounts a fresh, non-executable procfs for the private PID namespace.
  mount fstype=proc options=(rw nosuid nodev noexec) proc -> /newroot/proc/,
  # Bubblewrap covers writable legacy proc nodes with read-only self-binds.
  mount options=(rw rbind) /newroot/proc/{sys,sysrq-trigger,irq,bus}{,/**} -> /newroot/proc/{sys,sysrq-trigger,irq,bus}{,/**},
  mount options=(ro remount bind nosuid nodev) -> /newroot/proc/{sys,sysrq-trigger,irq,bus}{,/**},
  # --dev creates a nodev,nosuid tmpfs, then a noexec devpts instance.
  mount fstype=tmpfs options=(rw nosuid nodev) none -> /newroot/dev/,
  mount fstype=devpts options=(rw nosuid noexec) devpts -> /newroot/dev/pts/,
  # --dev exposes only Bubblewrap's six standard device nodes from oldroot.
  mount options=(rw rbind) /oldroot/dev/{null,zero,full,random,urandom,tty} -> /newroot/dev/{null,zero,full,random,urandom,tty},
  mount options=(rw remount bind nosuid) -> /newroot/dev/{null,zero,full,random,urandom,tty},
  # --tmpfs /tmp creates the sandbox's only writable ordinary filesystem.
  mount fstype=tmpfs options=(rw nosuid nodev) none -> /newroot/tmp/,

  deny /sys/[^f]*/** wklx,
  deny /sys/f[^s]*/** wklx,
  deny /sys/fs/[^c]*/** wklx,
  deny /sys/fs/c[^g]*/** wklx,
  deny /sys/fs/cg[^r]*/** wklx,
  deny /sys/firmware/** rwklx,
  deny /sys/devices/virtual/powercap/** rwklx,
  deny /sys/kernel/security/** rwklx,

  ptrace (trace,tracedby,read,readby) peer=songmaker-web,
}

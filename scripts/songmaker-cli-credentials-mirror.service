[Unit]
Description=Songmaker agent-CLI login mirror (issue #350)
# songmaker.service requires this unit since #398 (Requires=/After=); the
# containers do not read the copies yet.
# A mirror that stops running is exactly the failure nobody notices: the
# containers keep serving the token they started with until it expires, and
# the co-writer then dies with "Claude CLI is unavailable". Same alert path
# as the auto-deploy tick (issue #333).
OnFailure=songmaker-alert@%n.service

[Service]
Type=oneshot
# WorkingDirectory, ExecStart, and User below are placeholders (this repo's
# canonical checkout/owner), kept concrete only so `systemd-analyze verify`
# can check absolute paths. scripts/install-cli-credentials-mirror.sh always
# overwrites all three with the real project root and invoking user at
# install time — copying this file by hand instead of running that script
# inherits these values as-is, which is very likely wrong for a different
# checkout or operator.
WorkingDirectory=/home/felix-hummert/git/songmaker
ExecStart=/home/felix-hummert/git/songmaker/scripts/mirror_agent_cli_credentials.py --home /home/felix-hummert --mirror-dir /home/felix-hummert/.songmaker/agent-cli-credentials
User=felix-hummert
# --home and --mirror-dir are written out in full rather than left to the
# script's own defaults: compose resolves the same directory from
# SONGMAKER_CLI_CREDENTIALS_DIR, and the installer resolves it once and writes
# that one answer into this line and into the preflight it runs. Three places
# deriving a path from three environments is how an installer reports success
# for files compose never mounts.
#
# No Group= override and no StateDirectory: the mirror writes into the
# invoking user's own directory, which is also where a manual run writes.
#
# No TimeoutStartSec override: this copies three files of a few hundred bytes
# each. Anything that takes longer than systemd's default is a hang worth
# killing.

[Install]
WantedBy=multi-user.target

[Unit]
Description=Songmaker stack (docker compose up -d) after boot
After=docker.service
Requires=docker.service
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/home/felix-hummert/git/songmaker
ExecStart=/usr/bin/docker compose up -d
Restart=on-failure
RestartSec=10
User=felix-hummert
Group=docker

[Install]
WantedBy=multi-user.target

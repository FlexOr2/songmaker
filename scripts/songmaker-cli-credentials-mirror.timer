[Unit]
Description=Songmaker agent-CLI login mirror safety net (issue #350)

[Timer]
OnBootSec=1min
OnUnitActiveSec=10min
# Persistent=false: this is a poll, not a task with a deadline. Nothing is
# owed for the time the host was off — the next tick copies whatever the
# login files say then.
Persistent=false
Unit=songmaker-cli-credentials-mirror.service

[Install]
WantedBy=timers.target

# ═══════════════════════════════════════════════════════════════
# Songmaker — Git Ignore
# ═══════════════════════════════════════════════════════════════

# ── Three top-level folders for all large/generated files ──
_models/
_cache/
_output/
_recovery/

# ── Audio files (safety net) ──
*.wav
*.mp3

# ── Python bytecode ──
__pycache__/
*.py[cod]
*$py.class
*.pyo

# ── Virtual environments ──
venv/
.venv/
.venv-*/
env/

# ── Claude Code ──
.claude/

# ── Build artifacts ──
*.egg-info/

# ── IDE ──
.vscode/
.idea/
*.swp
*.swo

# ── OS files ──
Thumbs.db
.DS_Store

# ── Torch model checkpoints (safety net) ──
*.pt
*.pth
*.ckpt

# ── Frontend ──
frontend/node_modules/
frontend/.svelte-kit/
frontend/build/

# ── Misc ──
.coverage
.pytest_cache/
.ruff_cache/
albums/*/legacy_sources/
albums/*/legacy_output/
_reference/
_archive/
.env
.pr-drafts/

# ═══════════════════════════════════════════════════════════════
# Songmaker — Git Ignore
# ═══════════════════════════════════════════════════════════════

# Generated audio output (large binary files)
albums/*/output/*.mp3
albums/*/output/*.wav
albums/*/legacy_output/

# Temporary audio files
_temp_*
*.wav
*.mp3

# Bark vocal cache (reusable across runs)
_vocal_cache/

# Python bytecode
__pycache__/
*.py[cod]
*$py.class
*.pyo

# Virtual environments
venv/
.venv/
env/
_rvc_venv/

# RVC voice models (large binary files)
rvc_models/

# Voice reference audio files (for XTTS cloning)
voice_refs/

# Claude Code
.claude/

# Build artifacts
*.egg-info/

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS files
Thumbs.db
.DS_Store

# Bark model cache (downloaded ~5GB)
# Stored in ~/.cache/suno/bark_v0/ by default — not in project

# SoundFont files (optional, large)
soundfonts/*.sf2

# Torch model checkpoints
*.pt
*.pth
*.ckpt

# Planning docs (stale specs, already implemented)
plans/

# Legacy sources (archived, not needed for new development)
albums/*/legacy_sources/

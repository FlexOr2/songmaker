# Coverage config for CI. These patterns are mirrored in sonar-project.properties
# so SonarCloud does not count intentionally unmeasurable files as 0% coverage.
[run]
omit =
    # why: src/songmaker_cli/main.py is a CLI entry point with local recovery commands.
    src/songmaker_cli/main.py
    # why: src/songmaker_cli/scoring/audiobox_aesthetics.py needs a heavy model runtime absent from CI.
    src/songmaker_cli/scoring/audiobox_aesthetics.py
    # why: src/songmaker_cli/scoring/emotional_dynamics.py needs a heavy model runtime absent from CI.
    src/songmaker_cli/scoring/emotional_dynamics.py
    # why: src/songmaker_cli/scoring/lyrical_coherence.py requires an external provider runtime.
    src/songmaker_cli/scoring/lyrical_coherence.py
    # why: src/songmaker_cli/scoring/text_accuracy.py requires the Whisper model absent from CI.
    src/songmaker_cli/scoring/text_accuracy.py
    # why: src/songmaker_cli/db/migrations/versions/** requires Alembic/PostgreSQL semantics.
    src/songmaker_cli/db/migrations/versions/**
    # why: frontend/src/service-worker.ts belongs to a browser/build proof, not Vitest coverage.
    frontend/src/service-worker.ts

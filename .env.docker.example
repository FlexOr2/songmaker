# Songmaker .env example — copy to .env and fill in values.
#
# This is the ONLY env file. The app reads it via Pydantic Settings; Docker
# Compose reads it for variable substitution into the container environment
# blocks (e.g. DATABASE_URL is constructed below from POSTGRES_USER/PASSWORD/DB).
#
# IMPORTANT: Settings uses extra="forbid" — a typo'd env var name (e.g.
# REQUSET_TIMEOUT) will fail Settings construction at startup with a clear
# ValidationError instead of silently using the default. This is intentional
# (see plans/no-silent-fallbacks-v2.md).
#
# To generate a secret: python3 -c "import secrets; print(secrets.token_hex(32))"

# ─────────────────────────────────────────────────────────────────────────
# REQUIRED — Settings raises ValidationError at startup if any of these are
# missing. POSTGRES_* are also consumed by docker-compose to construct
# DATABASE_URL for the postgres container.
# ─────────────────────────────────────────────────────────────────────────

SESSION_SECRET=CHANGEME_generate_with_command_above
POSTGRES_USER=songmaker
POSTGRES_PASSWORD=CHANGEME_generate_a_strong_password
POSTGRES_DB=songmaker
SONGMAKER_INTERNAL_TOKEN=CHANGEME_generate_with_command_above

# Admin account — created on first startup if no users exist.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGEME_strong_password

# Grafana monitoring (http://localhost:3000)
GRAFANA_USER=admin
GRAFANA_PASSWORD=CHANGEME_grafana_password

# ─────────────────────────────────────────────────────────────────────────
# Set automatically by docker-compose — do NOT add to .env unless you know
# what you're doing. docker-compose.yml uses the POSTGRES_* values above
# (and a hardcoded redis hostname) to build these URLs and pass them into
# the container's environment block. The app reads them from there.
# ─────────────────────────────────────────────────────────────────────────
#
# DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}
# REDIS_URL=redis://redis:6379/0

# ─────────────────────────────────────────────────────────────────────────
# OPTIONAL — overrides for any Settings field. The defaults shown here
# match src/songmaker_cli/settings.py exactly (verified 2026-04-09).
# Uncomment a line only if you actually want to change the default.
# ─────────────────────────────────────────────────────────────────────────

# ── Access control ──────────────────────────────────────────────────────
# ALLOWED_HOSTS=yourdomain.com,localhost      # default: "" (no host check)
# CORS_ORIGIN=https://yourdomain.com          # default: None (no CORS)
# TRUSTED_PROXIES=172.16.0.0/12               # default: "" (no proxies)

# ── HTTP server ─────────────────────────────────────────────────────────
# HOST=0.0.0.0                                # default: 127.0.0.1
# REQUEST_TIMEOUT=30                          # uvicorn keep-alive seconds
# MAX_REQUEST_BODY_BYTES=1048576              # 1 MB
# MAX_UPLOAD_BODY_BYTES=52428800              # 50 MB

# ── Logging ─────────────────────────────────────────────────────────────
# LOG_FORMAT=json                             # "text" or "json", default: text
# LOG_LEVEL=INFO                              # standard logging level

# ── Database connection pool ────────────────────────────────────────────
# DATABASE_POOL_SIZE=5
# DATABASE_MAX_OVERFLOW=10

# ── Sessions ────────────────────────────────────────────────────────────
# SESSION_MAX_AGE=2592000                     # 30 days, sliding window
# SESSION_ABSOLUTE_MAX_AGE=7776000            # 90 days, hard cap

# ── Auth rate limits ────────────────────────────────────────────────────
# LOGIN_RATE_LIMIT=5                          # failed logins per 5-min window
# LOGIN_LOCKOUT_THRESHOLD=15                  # failed attempts before lockout
# LOGIN_LOCKOUT_WINDOW=3600                   # lockout window in seconds
# IP_RATE_LIMIT=120                           # global per-IP req/min

# ── Job rate limits (per hour, overrideable per-user in settings UI) ────
# GENERATION_RATE_LIMIT_USER=3
# GENERATION_RATE_LIMIT_ADMIN=30
# SCORING_RATE_LIMIT_USER=10
# SCORING_RATE_LIMIT_ADMIN=100
# CHAT_RATE_LIMIT_USER=30
# CHAT_RATE_LIMIT_ADMIN=300
# MAX_QUEUE_DEPTH=100                         # global queued-jobs ceiling
# MAX_USER_ACTIVE_JOBS=10                     # per-user concurrent ceiling

# ── arq workers ─────────────────────────────────────────────────────────
# ARQ_JOB_TIMEOUT=1000                        # max seconds per job (~17 min — long enough for cold xl-turbo load)
# ARQ_DRAIN_TIMEOUT=300                       # graceful shutdown drain
# MUSIC_MAX_JOBS=2                            # concurrent jobs in music-worker
# SCORING_MAX_JOBS=1                          # concurrent jobs in scoring-worker
# SCORING_DEVICE=cpu                          # "cpu" or "cuda"
# SCORER_TIMEOUT_SECONDS=120                  # budget per scorer
# TEXT_ACCURACY_TIMEOUT_SECONDS=300           # own budget — a cold Whisper model load counts against it
# STALE_JOB_THRESHOLD_SECONDS=1100            # mark jobs as stale after this (must exceed ARQ_JOB_TIMEOUT)

# ── Soft delete ─────────────────────────────────────────────────────────
# SOFT_DELETE_RETENTION_DAYS=30               # before hard delete

# ── Filesystem (Docker volume mounts override these in docker-compose) ──
# AUDIO_DIR=data/audio                        # generated audio files
# DATA_DIR=data                               # general data dir

# ── Claude integration ──────────────────────────────────────────────────
# CLAUDE_CHAT_MODEL=claude-opus-4-6           # co-writer model
# CLAUDE_SCORING_MODEL=claude-opus-4-6        # lyrical-coherence model
# ANTHROPIC_API_KEY=sk-ant-...                # Claude API key
#
# Without ANTHROPIC_API_KEY, the Claude CLI (Max subscription) is used
# via bind mounts in docker-compose.yml (~/.local/bin/claude, ~/.claude,
# ~/.claude.json). Remove those mounts when switching to an API key.

# ── ACE-Step worker pool ────────────────────────────────────────────────
#
# The ACE-Step subprocess runs inside the songmaker-acestep-worker-0
# container. WORKER_ID/HOST/PORT/GPU_ID are set in docker-compose.yml
# and typically don't need overrides. See docs/acestep.md for the
# worker pool architecture.
#
# ACESTEP_WORKER_VRAM_GB=22                   # VRAM budget per worker
# ACESTEP_WORKER_CONTROL_PLANE_URL=http://songmaker-web:8080
# ACESTEP_STARTUP_TIMEOUT_SECONDS=900         # subprocess health-check window (cold xl-turbo + vLLM warmup ~5–8 min)
# HF_TOKEN=hf_...                             # Hugging Face token for model downloads

# Docker Compose environment — copy to .env and fill in values.
# Generate secrets: python3 -c "import secrets; print(secrets.token_hex(32))"

# ── Required ─────────────────────────────────────────────────────────

SESSION_SECRET=CHANGEME_generate_with_command_above
POSTGRES_USER=songmaker
POSTGRES_PASSWORD=CHANGEME_generate_a_strong_password
POSTGRES_DB=songmaker

# ── Admin account (created on first startup if no users exist) ───────

ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGEME_strong_password

# ── Access control ───────────────────────────────────────────────────

# ALLOWED_HOSTS=yourdomain.com,localhost
# CORS_ORIGIN=https://yourdomain.com
# TRUSTED_PROXIES=172.16.0.0/12

# ── Database ─────────────────────────────────────────────────────────

# DATABASE_URL=postgresql://songmaker:password@postgres:5432/songmaker
# DATABASE_POOL_SIZE=5          # PostgreSQL connection pool size (default: 5)
# DATABASE_MAX_OVERFLOW=10      # Extra connections beyond pool_size (default: 10)

# ── Redis ────────────────────────────────────────────────────────────

# REDIS_URL=redis://redis:6379/0

# ── Server ───────────────────────────────────────────────────────────

# HOST=0.0.0.0                  # Bind address (default: 127.0.0.1)
# REQUEST_TIMEOUT=30            # Uvicorn keep-alive timeout in seconds
# LOG_FORMAT=json               # "json" for production, "text" for dev (default: text)
# MAX_REQUEST_BODY_BYTES=1048576      # Max request body, 1 MB default
# MAX_UPLOAD_BODY_BYTES=52428800      # Max upload body (reimport), 50 MB default
# IP_RATE_LIMIT=120             # Global per-IP requests/minute (default: 120)

# ── Worker / arq ─────────────────────────────────────────────────────

# ARQ_JOB_TIMEOUT=300           # Max seconds per job before timeout (default: 300)
# ARQ_DRAIN_TIMEOUT=300         # Max seconds to drain queue on shutdown (default: 300)
# AUDIO_DIR=/app/audio          # Audio file storage directory
# DATA_DIR=/app/data            # Data directory (session secret, etc.)
# STALE_JOB_THRESHOLD_SECONDS=360  # Jobs older than this are marked stale (default: 360)

# ── ACE-Step worker pool ─────────────────────────────────────────────
#
# The ACE-Step subprocess runs inside the songmaker-acestep-worker-0
# container. WORKER_ID/HOST/PORT/GPU_ID are set in docker-compose.yml
# and typically don't need overrides. See docs/acestep.md for the
# worker pool architecture.

# Shared secret for worker ↔ control-plane internal API auth.
# Required. Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
SONGMAKER_INTERNAL_TOKEN=CHANGEME_generate_with_command_above

# Hugging Face token — required by the acestep-worker to download model
# weights via the admin UI, and by the scoring-worker for whisper/audiobox.
# HF_TOKEN=hf_...

# VRAM budget per acestep-worker in GB (default: 22)
# ACESTEP_WORKER_VRAM_GB=22

# Control plane URL the acestep-worker registers with (default: http://songmaker-web:8080)
# ACESTEP_WORKER_CONTROL_PLANE_URL=http://songmaker-web:8080

# Timeout for the ACE-Step subprocess startup probe in seconds (default: 300)
# ACESTEP_STARTUP_TIMEOUT_SECONDS=300

# ── Rate limits (per hour, overrideable per-user in settings UI) ─────

# GENERATION_RATE_LIMIT_USER=3
# GENERATION_RATE_LIMIT_ADMIN=30
# SCORING_RATE_LIMIT_USER=10
# SCORING_RATE_LIMIT_ADMIN=100
# CHAT_RATE_LIMIT_USER=30
# CHAT_RATE_LIMIT_ADMIN=300
# MAX_QUEUE_DEPTH=10            # Max total queued jobs across all users
# LOGIN_RATE_LIMIT=5            # Failed login attempts per 5-minute window
# LOGIN_LOCKOUT_THRESHOLD=15    # Failed attempts before lockout (default: 15)
# LOGIN_LOCKOUT_WINDOW=3600     # Lockout window in seconds (default: 3600)

# ── Sessions ─────────────────────────────────────────────────────────

# SESSION_MAX_AGE=2592000       # Sliding window, 30 days default (seconds)
# SESSION_ABSOLUTE_MAX_AGE=7776000  # Hard max, 90 days default (seconds)

# ── Claude integration ───────────────────────────────────────────────

# ANTHROPIC_API_KEY=sk-ant-...  # Claude API key for chat co-writer and lyrical coherence scoring
# Without API key, the Claude CLI (Max subscription) is used via bind mounts
# in docker-compose.yml (~/.local/bin/claude, ~/.claude, ~/.claude.json).
# Remove those mounts when switching to an API key.

# ── Grafana monitoring (http://localhost:3000) ───────────────────────

GRAFANA_USER=admin
GRAFANA_PASSWORD=CHANGEME_grafana_password

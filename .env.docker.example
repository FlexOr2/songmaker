# Docker Compose environment — copy to .env and fill in values.
# Generate secrets: python3 -c "import secrets; print(secrets.token_hex(32))"

SESSION_SECRET=CHANGEME_generate_with_command_above
POSTGRES_USER=songmaker
POSTGRES_PASSWORD=CHANGEME_generate_a_strong_password
POSTGRES_DB=songmaker

# Admin account (created on first startup if no users exist)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGEME_strong_password

# Access control — set to your domain if using Cloudflare Tunnel
# ALLOWED_HOSTS=yourdomain.com,localhost
# CORS_ORIGIN=https://yourdomain.com
# TRUSTED_PROXIES=172.16.0.0/12

# Grafana monitoring (http://localhost:3000)
GRAFANA_USER=admin
GRAFANA_PASSWORD=CHANGEME_grafana_password
